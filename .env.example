# ERDIS Environment Variables Configuration Example
APP_NAME=ERDIS
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Database Configuration (PostgreSQL)
POSTGRES_USER=erdis_user
POSTGRES_PASSWORD=erdis_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erdis_system_db

# Read-Only Database Role (for SQL Agent)
READONLY_DB_USER=erdis_readonly
READONLY_DB_PASSWORD=erdis_readonly_password

# Vector Database Configuration (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=erdis_documents

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# RAG Pipeline Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DENSE_TOP_K=10
BM25_TOP_K=10
RERANK_TOP_K=5
RELEVANCE_THRESHOLD=0.65

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=erdis-investigation
